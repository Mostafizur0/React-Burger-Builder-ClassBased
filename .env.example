# Copy to .env.local and fill in your own Firebase web configuration.
# A Firebase web config is public by design; it is not a secret.
# Restrict the API key in the Google Cloud console (HTTP referrers + required APIs)
# and enforce access with the rules in firebase.database.rules.json.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_DATABASE_URL=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_APP_ID=
