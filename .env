# Firebase web configuration for the default project.
#
# A Firebase web config is public by design: it ships inside the browser bundle.
# It is NOT a secret. Access is constrained by the Realtime Database rules in
# firebase.database.rules.json and by API-key restrictions configured in the
# Google Cloud console (HTTP referrers + required APIs).
#
# Override these values locally in .env.local (git-ignored) or per environment.
#
# NOTE: these are the values from .env.local, kept in sync so a fresh clone
# builds with the same project. The project is exercised through the local
# Firebase Emulator Suite by default - see the README for how to start it.
REACT_APP_FIREBASE_API_KEY=AIzaSyCi8kZHcinIYYLGTFKeFl_7skwAx4TiZDE
REACT_APP_FIREBASE_AUTH_DOMAIN=burger-builder-951c6.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=burger-builder-951c6
REACT_APP_FIREBASE_DATABASE_URL=https://burger-builder-951c6-default-rtdb.asia-southeast1.firebasedatabase.app/
REACT_APP_FIREBASE_STORAGE_BUCKET=burger-builder-951c6.firebasestorage.app
REACT_APP_FIREBASE_APP_ID=1:390447306725:web:6a0023c81c7834244b410c
