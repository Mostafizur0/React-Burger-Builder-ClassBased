# Peer dependencies are resolved normally here. `legacy-peer-deps` would stop npm
# from satisfying `ajv-keywords@5`'s `ajv@^8` peer, leaving it bound to the
# `ajv@6` that eslint hoists, which breaks the webpack build with
# "Cannot find module 'ajv/dist/compile/codegen'".
legacy-peer-deps=false
audit=false
fund=false
