{
  "name": "react-burger-builder",
  "version": "1.0.0",
  "private": true,
  "description": "Burger builder SPA built with React class components, Redux and Firebase.",
  "license": "MIT",
  "homepage": "/",
  "engines": {
    "node": ">=18 <21",
    "npm": ">=9"
  },
  "dependencies": {
    "firebase": "^11.0.2",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^8.1.3",
    "react-router-dom": "^5.3.4",
    "react-scripts": "5.0.1",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "cross-env": "^7.0.3",
    "typescript": "4.9.5"
  },
  "overrides": {
    "svgo": "^2.8.4",
    "postcss": "^8.5.33",
    "nth-check": "^2.1.1",
    "css-select": "^5.1.0",
    "serialize-javascript": "^7.1.3",
    "underscore": "^1.13.7",
    "jsonpath": "^1.1.1",
    "webpack-dev-middleware": "^7.4.6",
    "eslint": {
      "ajv": "^6.12.6"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.6"
    },
    "@grpc/grpc-js": "^1.14.7",
    "deepmerge": "^4.3.1",
    "uuid": "^11.1.1",
    "@tootallnate/once": "^2.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "cross-env NODE_OPTIONS=--experimental-global-webcrypto react-scripts build",
    "test": "react-scripts test",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "lint": "eslint --ext .js,.jsx src",
    "eject": "react-scripts eject"
  },
  "jest": {
    "resetMocks": false,
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/test-utils.js",
      "!src/setupTests.js",
      "!src/store/actions/index.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 2 chrome version",
      "last 2 firefox version",
      "last 2 safari version"
    ]
  }
}
